{
  "name": "strelingo-smart",
  "version": "1.0.0",
  "description": "Dual-language subtitles (the film's language + yours) synced to the file you actually play — Stremio & Nuvio add-on",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p .",
    "test": "tsx test/aligner.test.ts && tsx test/file.test.ts && tsx test/pipeline.test.ts && tsx test/server.test.ts",
    "test:encoding": "tsx test/encoding.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.6",
    "chardet": "2.2.0",
    "dotenv": "17.4.2",
    "fflate": "0.8.3",
    "franc-all": "7.2.0",
    "hono": "4.12.27",
    "iconv-lite": "0.7.2",
    "iso-639-3": "3.0.1",
    "srt-parser-2": "1.2.3",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
