# Strelingo Smart — copy to .env for local runs. Everything is optional.

# Port to listen on (Render and most hosts set this for you).
PORT=7000

# The address players reach the add-on at, when the host can't tell
# (behind a reverse proxy or tunnel). Usually auto-detected.
# EXTERNAL_URL=https://strelingo.example.com

# Signs the 🎓 /play links so the add-on can't be used as an open redirect.
# Without it, the key is derived from the shared store's token below, or (no
# store) a random secret is generated and kept in DATA_DIR.
# SECRET=change-me-to-a-long-random-string

# Shared state — required on Vercel, where every request may run on another
# instance (which file you're playing, finished subtitles). Either one:
#   Upstash Redis (Vercel → Storage → Upstash; these are set for you):
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
#   (KV_REST_API_URL / KV_REST_API_TOKEN work too)
#   or Turso — the same kind of database Smart-Hebrew-Subtitles uses:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Where that generated secret is kept.
# DATA_DIR=./data

# Name shown in Stremio / Nuvio.
# ADDON_NAME=Strelingo Smart

# How long a subtitle request may wait for the sync before the player gets a
# "still preparing — pick it again in a few seconds" message (milliseconds).
# SRT_WAIT_MS=30000

# Password for the activity page at / (everyone's activity). Without it the
# page is open to anyone who knows the server address. Per-configuration pages
# (/<config>/status) never need it.
# ADMIN_PASSWORD=

# A report from the player ("⚠ … · replace") counts only once the subtitle has
# been on screen this long (players may fetch every listed entry up front).
# REPORT_MIN_VIEW_MS=15000

# Allow stream add-ons and stream files on localhost / LAN addresses (only for a
# self-hosted add-on next to a self-hosted AIOStreams). Off on public servers.
# ALLOW_PRIVATE_ADDRESSES=true
